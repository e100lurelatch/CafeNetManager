<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Chuỗi kết nối SQL Server. Mỗi người sửa "Server=" theo Server Name khi đăng nhập SSMS:
        - Bản cài mặc định (như máy Bảo: DESKTOP-H2U3J31) -> Server=.
        - Bản Express                                     -> Server=.\SQLEXPRESS
        - LocalDB                                         -> Server=(localdb)\MSSQLLocalDB
    -->
    <add name="CafeDB"
         connectionString="Server=.;Database=CafeNetManager;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
