<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Chuỗi kết nối SQL Server. Mỗi người sửa "Server=" theo Server Name khi đăng nhập SSMS:
        - Bản cài mặc định (như máy Bảo: DESKTOP-H2U3J31) -> Server=.
        - Bản Express                                     -> Server=.\SQLEXPRESS
        - LocalDB                                         -> Server=(localdb)\MSSQLLocalDB
    -->
    <add name="CafeDB"
         connectionString="Server=.;Database=CafeNetManager;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>

  <!--
    PayPal SANDBOX (Module 02 - Bảo) - tiền ảo, không mất tiền thật.
    Client ID / Secret dùng chung cả nhóm để trong file src/PayPal.local.config;
    file đó ghi đè các giá trị mẫu bên dưới.
  -->
  <appSettings file="PayPal.local.config">
    <!-- Real = gọi PayPal Sandbox thật; Simulate = màn hình thanh toán giả để demo khi không có mạng -->
    <add key="PayPal_Mode" value="Real" />
    <add key="PayPal_ClientId" value="DIEN_CLIENT_ID" />
    <add key="PayPal_Secret" value="DIEN_SECRET" />
    <add key="PayPal_BaseUrl" value="https://api-m.sandbox.paypal.com" />
    <add key="PayPal_ReturnUrl" value="http://localhost/paypal_return" />
    <add key="PayPal_CancelUrl" value="http://localhost/paypal_return/cancel" />
    <!-- PayPal không hỗ trợ VND: quy đổi sang USD theo tỷ giá này -->
    <add key="PayPal_Currency" value="USD" />
    <add key="PayPal_VndPerUsd" value="25000" />
  </appSettings>
</configuration>
