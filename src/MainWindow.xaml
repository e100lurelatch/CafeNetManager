<Window x:Class="CafeNetManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CafeNetManager"
        xmlns:vm="clr-namespace:CafeNetManager.ViewModels"
        mc:Ignorable="d"
        Title="ÊM COFFEE - CafeNetManager"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style cho các nút menu điều hướng trên Sidebar -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B5B5B5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="10,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Thanh nhấn bên trái khi mục đang được chọn -->
                                <Border x:Name="ActiveIndicator"
                                        Grid.Column="0"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="1.5"
                                        Background="#E0A844"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>

                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <ContentPresenter Grid.Column="2"
                                                  Margin="10,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavRoot" Property="Background" Value="#232323"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavRoot" Property="Background" Value="#2B2317"/>
                                <Setter TargetName="NavRoot" Property="BorderBrush" Value="#4A381D"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#F3C46B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho nút Đăng xuất -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#251C1C"/>
            <Setter Property="BorderBrush" Value="#3D2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8A5A5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3B2020"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#B84A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#4A2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style chung cho thẻ thống kê phẳng ở trang Tổng quan -->
        <Style x:Key="StatCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2C2C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- DataTemplate cho trang mặc định "Tổng quan" -->
        <DataTemplate DataType="{x:Type vm:DashboardHomeContent}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,8">
                    <!-- Khối chào mừng đơn giản -->
                    <Border Background="#1E1E1E"
                            BorderBrush="#2C2C2C"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,18"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Xin chào, "
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding UserName}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#F3C46B"/>
                                <TextBlock Text="!"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Ngày hôm nay: "
                                           FontSize="12.5"
                                           Foreground="#8E8E8E"/>
                                <TextBlock Text="{Binding CurrentDateText}"
                                           FontSize="12.5"
                                           Foreground="#B5B5B5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4 thẻ thống kê phẳng -->
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource StatCardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Bàn đang phục vụ"
                                               FontSize="13"
                                               Foreground="#A8A8A8"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE80A;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="#C88A2B"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="0 / 0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Doanh thu hôm nay"
                                               FontSize="13"
                                               Foreground="#A8A8A8"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE8C7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="#C88A2B"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="0 đ"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Hóa đơn trong ngày"
                                               FontSize="13"
                                               Foreground="#A8A8A8"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE8A5;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="#C88A2B"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Ưu đãi đang chạy"
                                               FontSize="13"
                                               Foreground="#A8A8A8"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE8EC;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="#C88A2B"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar trái (~230px) -->
            <ColumnDefinition Width="236"/>
            <!-- Vùng nội dung chính -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR BÊN TRÁI ==================== -->
        <Border Grid.Column="0"
                Background="#141414"
                BorderBrush="#2A2A2A"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Trên cùng: Logo + tên ÊM COFFEE -->
                <StackPanel Grid.Row="0" Margin="18,18,18,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="8"
                                BorderBrush="#C88A2B"
                                BorderThickness="1.5">
                            <Border.Background>
                                <ImageBrush ImageSource="/Views/Images/logo.jpg" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ÊM COFFEE"
                                       FontSize="15.5"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"/>
                            <TextBlock Text="CafeNetManager"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#C88A2B"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#262626" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Danh sách nút menu điều hướng -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,2">
                    <StackPanel>
                        <TextBlock Text="DANH MỤC"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#6E6E6E"
                                   Margin="10,0,10,8"/>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     Content="Tổng quan"
                                     Tag="&#xE80F;"
                                     IsChecked="True"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Dashboard"/>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     Content="Sơ đồ bàn &amp; Gọi món"
                                     Tag="&#xE80A;"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Table"/>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     Content="Quản lý bàn"
                                     Tag="&#xE713;"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="TableManager"/>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     Content="Ưu đãi"
                                     Tag="&#xE8EC;"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Promotion"/>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     Content="Lịch sử hóa đơn"
                                     Tag="&#xE81C;"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="InvoiceHistory"/>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButtonStyle}"
                                     Content="Thông tin tài khoản"
                                     Tag="&#xE77B;"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Account"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Dưới cùng: Thông tin người dùng + nút Đăng xuất -->
                <StackPanel Grid.Row="2" Margin="14,6,14,14">
                    <Border Height="1" Background="#262626" Margin="0,0,0,12"/>

                    <Border Background="#1E1E1E"
                            BorderBrush="#2C2C2C"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="6"
                                    Background="#C88A2B"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserInitial}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#141414"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentUserRole}"
                                           FontSize="11.5"
                                           Foreground="#888888"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource LogoutButtonStyle}"
                            Command="{Binding LogoutCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7E8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,1,8,0"/>
                            <TextBlock Text="Đăng xuất"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== VÙNG NỘI DUNG BÊN PHẢI ==================== -->
        <Grid Grid.Column="1" Background="#181818">
            <Grid.RowDefinitions>
                <!-- Header phía trên vùng nội dung -->
                <RowDefinition Height="60"/>
                <!-- ContentControl hiển thị trang hiện tại -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1E1E1E"
                    BorderBrush="#2B2B2B"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding CurrentTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding CurrentSubtitle}"
                               FontSize="12"
                               Foreground="#888888"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Vùng hiển thị nội dung chính (mặc định là Tổng quan) -->
            <ContentControl Grid.Row="1"
                            Margin="24"
                            Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
