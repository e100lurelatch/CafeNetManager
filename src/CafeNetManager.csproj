<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kết nối SQL Server + đọc App.config -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
    <!-- Trình duyệt nhúng để mở trang thanh toán PayPal -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mã PayPal Sandbox riêng của từng máy, không push lên GitHub -->
    <None Include="PayPal.local.config" Condition="Exists('PayPal.local.config')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Views\Images\logo.jpg" />
    <None Remove="Views\Images\shop.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Views\Images\logo.jpg" />
    <Resource Include="Views\Images\shop.jpg" />
  </ItemGroup>

</Project>
