<UserControl x:Class="CafeNetManager.Views.Module02View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CafeNetManager.Views">
    <!-- Module 02 - Bảo: gom các màn hình của Bảo vào các tab.
         Quân có thể đặt UserControl này (hoặc từng View bên trong) vào menu điều hướng chung. -->
    <TabControl FontSize="14" Padding="0">
        <TabItem Header="  🪑 Sơ đồ bàn &amp; gọi món  ">
            <views:TableView/>
        </TabItem>
        <TabItem Header="  🛠 Quản lý bàn  ">
            <views:TableManagerView/>
        </TabItem>
        <TabItem Header="  🎁 Ưu đãi  ">
            <views:PromotionView/>
        </TabItem>
        <TabItem Header="  🧾 Hóa đơn  ">
            <views:InvoiceHistoryView/>
        </TabItem>
    </TabControl>
</UserControl>
