<UserControl x:Class="CafeNetManager.Views.PromotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CafeNetManager.ViewModels"
             Background="#FAF7F2" FontSize="14">
    <!-- Module 02 - Bảo: Quản lý ưu đãi -->
    <UserControl.DataContext>
        <vm:PromotionViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Coffee" Color="#6F4E37"/>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Danh sách ưu đãi -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="QUẢN LÝ ƯU ĐÃI" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Coffee}"/>
                <TextBlock Text="{Binding SummaryText}" Foreground="Gray" Margin="0,2,0,8"/>
                <DockPanel>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                             ToolTip="Tìm theo mã hoặc tên ưu đãi"/>
                </DockPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Promotions}" SelectedItem="{Binding SelectedPromotion}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                      Background="White" BorderBrush="#E0D6CC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Tên ưu đãi" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Mức giảm" Binding="{Binding DiscountText}" Width="170"/>
                    <DataGridTextColumn Header="Điều kiện" Binding="{Binding ConditionText}" Width="120"/>
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding PeriodText}" Width="170"/>
                    <DataGridTextColumn Header="Đã dùng" Binding="{Binding UsageText}" Width="70"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Đang chạy">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Hết hạn">
                                                    <Setter Property="Foreground" Value="#E53935"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Form thêm / sửa -->
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16" BorderBrush="#E0D6CC" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ Mới" Style="{StaticResource Action}" Background="#8D6E63" Command="{Binding NewCommand}"/>
                        <Button Content="💾 Lưu" Style="{StaticResource Action}" Background="#43A047" Command="{Binding SaveCommand}"/>
                        <Button Content="Bật / Tắt" Style="{StaticResource Action}" Background="#FB8C00" Command="{Binding ToggleActiveCommand}"/>
                        <Button Content="🗑" Style="{StaticResource Action}" Background="#E53935" Margin="0"
                                ToolTip="Xóa ưu đãi" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold"/>

                        <TextBlock Text="Mã ưu đãi (VD: GIAM10)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Padding="6,4"/>

                        <TextBlock Text="Tên ưu đãi" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                        <TextBlock Text="Loại giảm" Style="{StaticResource Label}"/>
                        <ComboBox SelectedIndex="{Binding DiscountTypeIndex}" Padding="6,4">
                            <ComboBoxItem Content="Giảm theo %"/>
                            <ComboBoxItem Content="Giảm số tiền cố định (đ)"/>
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Giá trị giảm (% hoặc đ)" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding IsPercent, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Giảm tối đa (đ, có thể trống)" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding MaxDiscount, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Đơn tối thiểu (đ)" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding MinOrder, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Số lượt dùng (trống = ∞)" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding UsageLimit, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Từ ngày" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding StartDate}" SelectedDateFormat="Short"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Đến ngày" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding EndDate}" SelectedDateFormat="Short"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Đang bật (cho phép dùng)" IsChecked="{Binding IsActive}" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
