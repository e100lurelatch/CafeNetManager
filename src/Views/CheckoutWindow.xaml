<Window x:Class="CafeNetManager.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán" Width="820" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#FAF7F2" FontSize="14">
    <!-- Module 02 - Bảo: Màn hình Thanh toán (ưu đãi + tiền mặt / PayPal + in hóa đơn) -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="Coffee" Color="#6F4E37"/>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Trái: danh sách món ===== -->
        <Border Background="White" CornerRadius="10" Padding="14" BorderBrush="#E0D6CC" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding TableName, StringFormat=Hóa đơn - {0}}"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource Coffee}" Margin="0,0,0,10"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Separator Margin="0,0,0,8"/>
                    <DockPanel>
                        <TextBlock Text="Tạm tính"/>
                        <TextBlock Text="{Binding SubTotal, StringFormat={}{0:N0}đ}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AppliedPromotion.Code, StringFormat=Ưu đãi ({0})}" Foreground="#2E7D32"/>
                        <TextBlock Text="{Binding DiscountAmount, StringFormat=-{0:N0}đ}" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="TỔNG CỘNG" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Total, StringFormat={}{0:N0}đ}" FontSize="24" FontWeight="Bold"
                                   Foreground="#E53935" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotal, StringFormat={}{0:N0}đ}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Quantity, Mode=OneWay}"/><Run Text=" x "/><Run Text="{Binding DrinkName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="Gray">
                                                <Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:N0}đ}"/>
                                                <Run Text="{Binding Note, Mode=OneWay}" FontStyle="Italic" Foreground="{StaticResource Coffee}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Phải: ưu đãi + thanh toán ===== -->
        <DockPanel Grid.Column="2">
            <!-- Nút cuối -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Hủy" Style="{StaticResource Action}" Background="#9E9E9E" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"/>
                <Button Content="✔  Xác nhận thanh toán" Style="{StaticResource Action}" Background="#43A047"
                        FontWeight="Bold" Command="{Binding ConfirmCommand}" IsDefault="True"/>
            </StackPanel>

            <StackPanel>
                <!-- Ưu đãi -->
                <Border Background="White" CornerRadius="10" Padding="14" BorderBrush="#E0D6CC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🎁 Mã ưu đãi" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Áp dụng" Style="{StaticResource Action}"
                                    Background="{StaticResource Coffee}" Margin="6,0,0,0" Padding="12,6"
                                    Command="{Binding ApplyCodeCommand}"/>
                            <TextBox Text="{Binding PromoCode, UpdateSourceTrigger=PropertyChanged}" Padding="6,5"
                                     CharacterCasing="Upper"/>
                        </DockPanel>
                        <TextBlock Text="Hoặc chọn mã đang có:" Foreground="Gray" FontSize="12" Margin="0,8,0,2"/>
                        <ComboBox ItemsSource="{Binding AvailablePromotions}" SelectedItem="{Binding SelectedPromotion}"
                                  DisplayMemberPath="DisplayText" Padding="6,4"/>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Bỏ mã" Padding="8,2" Background="Transparent"
                                    BorderThickness="0" Foreground="#E53935" Cursor="Hand"
                                    Command="{Binding RemovePromotionCommand}"
                                    Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding PromoMessage}" TextWrapping="Wrap" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PromoError}" Value="True">
                                                <Setter Property="Foreground" Value="#E53935"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Hình thức thanh toán -->
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,12,0,0"
                        BorderBrush="#E0D6CC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💳 Hình thức thanh toán" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Tiền mặt" IsChecked="{Binding IsCash}" GroupName="pay" Margin="0,0,24,0"/>
                            <RadioButton Content="PayPal (sandbox)" IsChecked="{Binding IsPayPal}" GroupName="pay"/>
                        </StackPanel>

                        <!-- Tiền mặt -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Tiền khách đưa" Foreground="Gray" FontSize="12"/>
                            <TextBox Text="{Binding CashReceivedText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="18" Padding="6,5" Margin="0,2,0,6"/>
                            <ItemsControl ItemsSource="{Binding QuickCashOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" ContentStringFormat="{}{0:N0}" Margin="0,0,6,6" Padding="10,4"
                                                Background="#F3ECE6" BorderBrush="#D7C7B8" Cursor="Hand"
                                                Command="{Binding DataContext.QuickCashCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ChangeText}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChangeNotEnough}" Value="True">
                                                <Setter Property="Foreground" Value="#E53935"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- PayPal -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsPayPal, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PayPalAmountText}" FontWeight="Bold" Foreground="#003087" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#003087" Margin="0,6,0,0">
                                Bấm "Xác nhận thanh toán" để mở trang PayPal Sandbox, đăng nhập bằng tài khoản
                                sandbox loại Personal rồi bấm thanh toán.
                            </TextBlock>
                            <TextBlock Text="Tài khoản test: developer.paypal.com → Testing Tools → Sandbox Accounts (email @personal.example.com)"
                                       Foreground="Gray" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
