<Window x:Class="CafeNetManager.Views.MockPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán (Mô phỏng)" Width="420" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <!-- Module 02 - Bảo: Màn hình thanh toán MÔ PHỎNG (PayPal) dùng để demo khi không có sandbox.
         Không trừ tiền thật, không gọi mạng. Bật/tắt bằng Payment_Mode trong App.config. -->
    <DockPanel>
        <Border x:Name="header" DockPanel.Dock="Top" Background="#003087" Padding="16,14">
            <StackPanel>
                <TextBlock x:Name="txtProvider" Text="PayPal" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Cổng thanh toán - CHẾ ĐỘ MÔ PHỎNG" Foreground="White" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
            <Button x:Name="btnSuccess" Content="✔  Thanh toán thành công" Height="42" Margin="0,0,0,8"
                    Background="#43A047" Foreground="White" BorderThickness="0" FontSize="15" Cursor="Hand"
                    Click="Success_Click"/>
            <Button Content="✖  Thanh toán thất bại" Height="36" Margin="0,0,0,8"
                    Background="#E53935" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Failed_Click"/>
            <Button Content="Hủy" Height="32" Background="#EEEEEE" BorderThickness="0" Cursor="Hand"
                    Click="Cancel_Click"/>
        </StackPanel>

        <StackPanel Margin="20,16" HorizontalAlignment="Center">
            <TextBlock Text="Số tiền thanh toán" Foreground="Gray" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtAmount" Text="0 đ" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,6"/>
            <TextBlock x:Name="txtOrder" Text="Mã đơn: ..." Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>

            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,8"
                    HorizontalAlignment="Center">
                <UniformGrid x:Name="qrGrid" Width="200" Height="200"/>
            </Border>
            <TextBlock Text="Mã QR minh họa (mô phỏng, không quét được)" Foreground="Gray" FontSize="11"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </DockPanel>
</Window>
