<UserControl x:Class="CafeNetManager.Views.TableManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CafeNetManager.ViewModels"
             Background="#FAF7F2" FontSize="14">
    <!-- Module 02 - Bảo: Quản lý bàn ăn (thêm / sửa / xóa) -->
    <UserControl.DataContext>
        <vm:TableManagerViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <SolidColorBrush x:Key="Coffee" Color="#6F4E37"/>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Danh sách bàn -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="QUẢN LÝ BÀN ĂN" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Coffee}"/>
                <TextBlock Text="{Binding SummaryText}" Foreground="Gray" Margin="0,2,0,8"/>
                <DockPanel>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                             ToolTip="Tìm theo tên bàn"/>
                </DockPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                      Background="White" BorderBrush="#E0D6CC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding TableId}" Width="60"/>
                    <DataGridTextColumn Header="Tên bàn" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Số chỗ" Binding="{Binding Capacity}" Width="80"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Form thêm / sửa -->
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16" VerticalAlignment="Top"
                BorderBrush="#E0D6CC" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="Tên bàn" Foreground="Gray" FontSize="12"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" Margin="0,2,0,10"/>
                <TextBlock Text="Số chỗ ngồi (1 - 30)" Foreground="Gray" FontSize="12"/>
                <TextBox Text="{Binding EditCapacity, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" Margin="0,2,0,16"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ Thêm mới" Style="{StaticResource Action}" Background="#8D6E63" Command="{Binding NewCommand}"/>
                    <Button Content="💾 Lưu" Style="{StaticResource Action}" Background="#43A047" Command="{Binding SaveCommand}"/>
                    <Button Content="🗑 Xóa" Style="{StaticResource Action}" Background="#E53935" Margin="0" Command="{Binding DeleteCommand}"/>
                </StackPanel>
                <TextBlock Margin="0,14,0,0" Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                           Text="Chọn một bàn trong danh sách để sửa. Chỉ xóa được bàn đang Trống; lịch sử hóa đơn của bàn vẫn được giữ."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
