<UserControl x:Class="CafeNetManager.Views.InvoiceHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CafeNetManager.ViewModels"
             Background="#FAF7F2" FontSize="14">
    <!-- Module 02 - Bảo: Lịch sử hóa đơn đã thanh toán -->
    <UserControl.DataContext>
        <vm:InvoiceHistoryViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <SolidColorBrush x:Key="Coffee" Color="#6F4E37"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderBrush" Value="#E0D6CC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="HÓA ĐƠN ĐÃ THANH TOÁN" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Coffee}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                <TextBlock Text="Từ" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="130"/>
                <TextBlock Text="đến" VerticalAlignment="Center" Margin="10,0,6,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="130"/>
                <Button Content="Hôm nay" Margin="10,0,0,0" Padding="10,4" Command="{Binding TodayCommand}"/>
                <Button Content="⟳ Tải lại" Margin="6,0,0,0" Padding="10,4" Command="{Binding RefreshCommand}"/>
            </StackPanel>
            <UniformGrid Columns="4" Margin="0,0,-10,12">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Số hóa đơn" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding InvoiceCount}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tổng thu" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0}đ}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tiền mặt / PayPal" Foreground="Gray" FontSize="12"/>
                        <TextBlock FontSize="16" FontWeight="Bold">
                            <Run Text="{Binding CashTotal, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=" / "/><Run Text="{Binding PayPalTotal, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="#003087"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Đã giảm (ưu đãi)" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding TotalDiscount, StringFormat={}{0:N0}đ}" FontSize="22" FontWeight="Bold" Foreground="#FB8C00"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30"
                  Background="White" BorderBrush="#E0D6CC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số HĐ" Binding="{Binding InvoiceId}" Width="70"/>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding PaidAtText}" Width="140"/>
                <DataGridTextColumn Header="Bàn" Binding="{Binding TableName}" Width="90"/>
                <DataGridTextColumn Header="Tạm tính" Binding="{Binding SubTotal, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="Mã ưu đãi" Binding="{Binding PromotionCode}" Width="100"/>
                <DataGridTextColumn Header="Giảm" Binding="{Binding DiscountAmount, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding Total, StringFormat=N0}" Width="110" FontWeight="Bold"/>
                <DataGridTextColumn Header="Hình thức" Binding="{Binding PaymentMethod}" Width="90"/>
                <DataGridTextColumn Header="Mã GD" Binding="{Binding TransactionRef}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
