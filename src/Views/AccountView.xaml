<UserControl x:Class="CafeNetManager.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="800"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B5B5B5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#C88A2B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Padding="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                    <Condition Property="IsReadOnly" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#4D4D4D"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                    <Condition Property="IsReadOnly" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#C88A2B"/>
                            </MultiTrigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Background" Value="#1B1B1B"/>
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2B2B2B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="#BDBDBD"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#CFCFCF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#C88A2B"/>
            <Setter Property="BorderBrush" Value="#C88A2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D99B38"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#D99B38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#B37920"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#B37920"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2F2F2F"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#525252"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1D1D1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="760"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#181818"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="8"
                        MaxWidth="760"
                        Padding="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Hồ sơ cá nhân"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <Border Height="1"
                                Background="#2A2A2A"
                                Margin="0,12,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Hàng 1: Tên đăng nhập | Vai trò -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Username, Mode=OneWay}"
                                         Style="{StaticResource FieldStyle}"
                                         IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Vai trò" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtVaiTro"
                                         Style="{StaticResource FieldStyle}"
                                         Text="{Binding VaiTro, Mode=OneWay}"
                                         IsReadOnly="True"/>
                            </StackPanel>

                            <!-- Hàng 2: Họ tên | Số điện thoại -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Họ tên" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtHoTen"
                                         Style="{StaticResource FieldStyle}"
                                         Text="{Binding HoTen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding DangChinhSua}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtSoDienThoai"
                                         Style="{StaticResource FieldStyle}"
                                         Text="{Binding SoDienThoai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding DangChinhSua}"/>
                            </StackPanel>

                            <!-- Hàng 3: Email (trải rộng 2 cột) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtEmail"
                                         Style="{StaticResource FieldStyle}"
                                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding DangChinhSua}"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Background="#2A2A2A"
                                Margin="0,20,0,18"/>

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Chỉnh sửa"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ChinhSuaCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Content="Lưu"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding LuuCommand}"
                                        IsEnabled="{Binding DangChinhSua}"
                                        Margin="0,0,10,0"/>
                                <Button Content="Hủy"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding HuyCommand}"
                                        IsEnabled="{Binding DangChinhSua}"/>
                            </StackPanel>

                            <Button Content="Đổi mật khẩu"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="btnDoiMatKhau_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
