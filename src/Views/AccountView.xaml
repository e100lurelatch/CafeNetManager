<UserControl x:Class="CafeNetManager.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="800"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F6FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="#1E1E1E"
                    Width="470"
                    Padding="30"
                    Margin="20"
                    CornerRadius="20"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="☕"
                               FontSize="32"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="ÊM COFFEE"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,8"/>

                    <TextBlock Text="THÔNG TIN TÀI KHOẢN"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Họ tên"
                               Foreground="White"/>
                    <TextBox x:Name="txtHoTen"
                             Style="{StaticResource FieldStyle}"
                             Text="{Binding HoTen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DangChinhSua}"/>

                    <TextBlock Text="Email"
                               Foreground="White"/>
                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource FieldStyle}"
                             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DangChinhSua}"/>

                    <TextBlock Text="Số điện thoại"
                               Foreground="White"/>
                    <TextBox x:Name="txtSoDienThoai"
                             Style="{StaticResource FieldStyle}"
                             Text="{Binding SoDienThoai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DangChinhSua}"/>

                    <TextBlock Text="Vai trò"
                               Foreground="White"/>
                    <TextBox x:Name="txtVaiTro"
                             Style="{StaticResource FieldStyle}"
                             Text="{Binding VaiTro, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,5,0,25"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Chỉnh sửa"
                                Style="{StaticResource ButtonStyle}"
                                Command="{Binding ChinhSuaCommand}"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="1"
                                Content="Lưu"
                                Style="{StaticResource ButtonStyle}"
                                Command="{Binding LuuCommand}"
                                IsEnabled="{Binding DangChinhSua}"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                                Content="Hủy"
                                Style="{StaticResource ButtonStyle}"
                                Command="{Binding HuyCommand}"
                                IsEnabled="{Binding DangChinhSua}"/>
                    </Grid>

                    <Button Content="Đổi mật khẩu"
                            Style="{StaticResource ButtonStyle}"
                            Click="btnDoiMatKhau_Click"
                            Margin="0,15,0,0"/>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
