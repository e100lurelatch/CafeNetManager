<UserControl x:Class="CafeNetManager.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="450"
             d:DesignWidth="800"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#F5F6FA">
        <Border Background="White"
                Padding="25"
                Width="420"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="THÔNG TIN TÀI KHOẢN"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Họ tên"/>
                <TextBox x:Name="txtHoTen"
                         Text="{Binding HoTen, Mode=TwoWay}"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Email"/>
                <TextBox x:Name="txtEmail"
                         Text="{Binding Email, Mode=TwoWay}"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Số điện thoại"/>
                <TextBox x:Name="txtSoDienThoai"
                         Text="{Binding SoDienThoai, Mode=TwoWay}"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Vai trò"/>
                <TextBox x:Name="txtVaiTro"
                         Text="{Binding VaiTro, Mode=OneWay}"
                         Height="30"
                         IsReadOnly="True"
                         Margin="0,5,0,20"/>


                <StackPanel Orientation="Horizontal">
                    <Button Content="Chỉnh sửa"
            Command="{Binding ChinhSuaCommand}"
            Width="100"
            Height="35"
            Margin="0,0,10,0"/>

                    <Button Content="Lưu"
            Command="{Binding LuuCommand}"
            IsEnabled="{Binding DangChinhSua}"
            Width="80"
            Height="35"
            Margin="0,0,10,0"/>

                    <Button Content="Hủy"
            Command="{Binding HuyCommand}"
            IsEnabled="{Binding DangChinhSua}"
            Width="80"
            Height="35"/>
                </StackPanel>



                <Button Content="Đổi mật khẩu"
        Click="btnDoiMatKhau_Click"
        Height="35"
        Margin="0,15,0,0"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
