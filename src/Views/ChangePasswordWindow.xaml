<Window x:Class="CafeNetManager.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="#F5F6FA">
        <Border Background="White"
                Padding="25"
                Margin="15"
                CornerRadius="10">

            <StackPanel>
                <TextBlock Text="ĐỔI MẬT KHẨU"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Mật khẩu cũ"/>
                <PasswordBox x:Name="pbMatKhauCu"
                             Height="30"
                             Margin="0,5,0,15"/>

                <TextBlock Text="Mật khẩu mới"/>
                <PasswordBox x:Name="pbMatKhauMoi"
                             Height="30"
                             Margin="0,5,0,15"/>

                <TextBlock Text="Xác nhận mật khẩu mới"/>
                <PasswordBox x:Name="pbXacNhan"
                             Height="30"
                             Margin="0,5,0,20"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Xác nhận"
                            Click="btnXacNhan_Click"
                            Width="100"
                            Height="35"
                            Margin="0,0,10,0"/>

                    <Button Content="Hủy"
                            Click="btnHuy_Click"
                            Width="80"
                            Height="35"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
