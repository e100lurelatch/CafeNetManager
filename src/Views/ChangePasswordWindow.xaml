<Window x:Class="CafeNetManager.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu - ÊM COFFEE"
        Height="510" Width="440" MinHeight="440"
        Background="#F5F6FA"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#1E1E1E" CornerRadius="20" Padding="25" Margin="15">
                <StackPanel>
                    <TextBlock Text="ĐỔI MẬT KHẨU" FontSize="20" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               Margin="0,5,0,10"/>
                    <TextBlock Text="Kiểm tra dữ liệu demo, chưa đổi mật khẩu thật"
                               Foreground="#E6BD78" FontSize="12"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Mật khẩu cũ" Foreground="White" FontSize="14"/>
                    <PasswordBox x:Name="pbMatKhauCu" Style="{StaticResource PasswordStyle}"/>
                    <TextBlock Text="Mật khẩu mới" Foreground="White" FontSize="14"/>
                    <PasswordBox x:Name="pbMatKhauMoi" Style="{StaticResource PasswordStyle}"/>
                    <TextBlock Text="Xác nhận mật khẩu mới" Foreground="White" FontSize="14"/>
                    <PasswordBox x:Name="pbXacNhan" Style="{StaticResource PasswordStyle}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Xác nhận" Click="btnXacNhan_Click"
                                Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Hủy" Click="btnHuy_Click"
                                Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
