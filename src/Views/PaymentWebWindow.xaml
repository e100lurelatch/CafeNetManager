<Window x:Class="CafeNetManager.Views.PaymentWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Thanh toán PayPal (Sandbox)" Width="1000" Height="760"
        WindowStartupLocation="CenterOwner">
    <!-- Module 02 - Bảo: Cửa sổ trình duyệt nhúng mở trang thanh toán online (PayPal).
         Khi PayPal chuyển về ReturnUrl / CancelUrl, cửa sổ bắt lại kết quả rồi tự đóng. -->
    <DockPanel>
        <Border x:Name="header" DockPanel.Dock="Top" Background="#003087" Padding="12,8">
            <TextBlock x:Name="txtStatus" Foreground="White" FontSize="14"
                       Text="Đang mở cổng thanh toán..."/>
        </Border>
        <wv2:WebView2 x:Name="webView"/>
    </DockPanel>
</Window>
