<Window x:Class="_25521512.BT02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_25521512.BT02"
        mc:Ignorable="d"
        x:Name="QuanLySanPham"
        Title="Quản lý sản phẩm" Height="450" Width="800" Loaded="QuanLySanPham_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Dòng 0: Tên màn hình -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 1, 2, 3: Các ô nhập liệu  -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Dòng 4: Thanh công cụ / Nút bấm -->
            <RowDefinition Height="Auto"/>
            <!-- Dòng 5: ĐẶT HEIGHT="*" ĐỂ LẤP ĐẦY CHIỀU CAO CÒN LẠI -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Dòng 0 -->
        <TextBlock Grid.Row="0" Text="QUẢN LÝ SẢN PHẨM" FontSize="20" HorizontalAlignment="Center" />
        <!-- Dòng 1, 2, 3: Các ô nhập liệu  -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="10,2,10,2">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 1/4 cho chữ -->
                    <ColumnDefinition Width="*"/>
                    <!-- 3/4 cho ô nhập -->
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tên Sản Phẩm" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="tbTenSanPham" Grid.Column="1" VerticalAlignment="Center"/>

            </Grid>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 1/4 cho chữ -->
                    <ColumnDefinition Width="*"/>
                    <!-- 3/4 cho ô nhập -->
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mã Sản Phẩm" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="tbMaSanPham" Grid.Column="1" VerticalAlignment="Center"/>

            </Grid>
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="2" Margin="10,2,10,2">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 1/4 cho chữ -->
                    <ColumnDefinition Width="34*"/>
                    <ColumnDefinition Width="253*"/>
                    <!-- 3/4 cho ô nhập -->
                </Grid.ColumnDefinitions>
                <TextBlock Text="Số lượng" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,35,0"/>
                <TextBox x:Name="tbSoLuong" Grid.Column="1" VerticalAlignment="Center" Grid.ColumnSpan="2"/>

            </Grid>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 1/4 cho chữ -->
                    <ColumnDefinition Width="*"/>
                    <!-- 3/4 cho ô nhập -->
                </Grid.ColumnDefinitions>
                <TextBlock Text="Đơn giá"  Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0"/>
                <TextBox x:Name ="tbDonGia"  Grid.Column="1" VerticalAlignment="Center"/>

            </Grid>
        </UniformGrid>
        <UniformGrid Grid.Row="3" Columns="2" Margin="10 2 10 2">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49.667"/>
                    <ColumnDefinition Width="43.483"/>
                    <!-- 1/4 cho chữ -->
                    <ColumnDefinition Width="*"/>
                    <!-- 3/4 cho ô chọn -->
                </Grid.ColumnDefinitions>
                <TextBlock Text="Đơn vị tính" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,35,0" Grid.ColumnSpan="2"/>
                <ComboBox x:Name="cbbDonViTinh" VerticalAlignment="Center" Margin="33,0,0,0" Grid.ColumnSpan="2" Height="22" Grid.Column="1" SelectionChanged="ComboBox_SelectionChanged"/>
            </Grid>
        </UniformGrid>
        <!-- Dòng 4: Thanh công cụ / Nút bấm -->
        <Grid Grid.Row="4" Margin="10,15,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnThem" Click="btnThem_Click" Content="Thêm" Grid.Column="0" MinWidth="80" Height="25" Margin="5,0,5,0" VerticalAlignment="Top"/>
            <Button x:Name="btnXoa" Click="btnXoa_Click" Content="Xóa" Grid.Column="1" MinWidth="80" Height="25" Margin="5,0,5,0" HorizontalAlignment="Stretch"/>
            <Button x:Name="btnSua" Click="btnSua_Click"  Content="Sửa" Grid.Column="2" MinWidth="80" Height="25" Margin="5,0,5,0" HorizontalAlignment="Stretch"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="tbTimKiem" MaxWidth="350" MinWidth="100" Height="25" VerticalContentAlignment="Center" Width="350" Margin="40,0,5,0"/>
                <Button x:Name="btnTimKiem" Click="btnTimKiem_Click" Content="Tìm kiếm" MinWidth="80" Height="25" Margin="0 0 5 0"/>
            </StackPanel>
        </Grid>
        <!-- Dòng 5: ĐẶT HEIGHT="*" ĐỂ LẤP ĐẦY CHIỀU CAO CÒN LẠI -->
        <Border Grid.Row="5" BorderBrush="#CCCCCC" BorderThickness="1" Background="#F0F2F5" Margin="15,5,15,15">
            <DataGrid x:Name="dgSanPham" IsReadOnly="False"   AutoGenerateColumns="False" ColumnWidth="*" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      CanUserAddRows="False" SelectionChanged="dgSanPham_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="MaSanPham" Header="Mã Sản Phẩm" Binding="{Binding MaSanPham}"/>
                    <DataGridTextColumn x:Name="TenSanPham" Header="Tên Sản Phẩm" Binding="{Binding TenSanPham}"/>
                    <DataGridTextColumn x:Name="SoLuong" Header="Số lượng" Binding="{Binding SoLuong}"/>
                        <DataGridTextColumn x:Name="DonGia" Header="Đơn giá" Binding="{Binding DonGia}"/>
                    <DataGridTextColumn x:Name="DonViTinh" Header="Đơn vị tính" Binding="{Binding DonViTinh}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
